{
  "name": "sdet-reliability-framework",
  "version": "1.0.0",
  "description": "The SDET Reliability Framework is a Python-based engineering project focused on software reliability, performance intelligence, and evidence-based release decisions.",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "postman:test": "newman run postman/SDET_Reliability_Framework.postman_collection.json -e postman/SDET_Reliability_Local.postman_environment.json",
    "postman:test:report": "newman run postman/SDET_Reliability_Framework.postman_collection.json -e postman/SDET_Reliability_Local.postman_environment.json --reporters cli,junit --reporter-junit-export reports/postman-newman-results.xml",
    "playwright:test": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtohagan716/sdet-reliability-framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jtohagan716/sdet-reliability-framework/issues"
  },
  "homepage": "https://github.com/jtohagan716/sdet-reliability-framework#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "newman": "^6.2.2"
  }
}